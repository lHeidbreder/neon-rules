%Narrative
\newcommand{\nrule}[3]{
	\begin{minipage}{\columnwidth}
		\section{#1}
		\textit{#2}\\
		\vspace{8mm}
		\begin{exampleblock}
			#3
		\end{exampleblock}
	\end{minipage}
	\par
}

